<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ClearGuard • پاک‌سازی با اطمینان" Width="1380" Height="920" MinWidth="1080" MinHeight="730" WindowStartupLocation="CenterScreen" Background="{DynamicResource Canvas}" FontFamily="Segoe UI" FontSize="16" Foreground="{DynamicResource Ink}" FlowDirection="RightToLeft">
 <Window.Resources>
  <!-- Primitive palette / semantic aliases / component styling -->
  <Color x:Key="Slate950">#101820</Color><Color x:Key="Slate900">#17242F</Color><Color x:Key="Slate800">#223440</Color><Color x:Key="Teal400">#59E3C0</Color><Color x:Key="Teal500">#38CBA8</Color><Color x:Key="WhiteSmoke">#F1F7F8</Color><Color x:Key="Slate300">#B3C5CE</Color><Color x:Key="Amber300">#FFD28B</Color>
  <SolidColorBrush x:Key="Canvas" Color="{StaticResource Slate950}"/><SolidColorBrush x:Key="Surface" Color="{StaticResource Slate900}"/><SolidColorBrush x:Key="Stroke" Color="{StaticResource Slate800}"/><SolidColorBrush x:Key="Accent" Color="{StaticResource Teal400}"/><SolidColorBrush x:Key="AccentHover" Color="{StaticResource Teal500}"/><SolidColorBrush x:Key="Ink" Color="{StaticResource WhiteSmoke}"/><SolidColorBrush x:Key="Muted" Color="{StaticResource Slate300}"/><SolidColorBrush x:Key="Warning" Color="{StaticResource Amber300}"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="{StaticResource Stroke}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Height" Value="46"/><Setter Property="Padding" Value="18,8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Plate" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Accent}" BorderThickness="0" CornerRadius="10"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Plate" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Plate" Property="Opacity" Value="0.6"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Plate" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Plate" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="{StaticResource Canvas}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,4"/><Setter Property="Height" Value="48"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource Stroke}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="20"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="{StaticResource Canvas}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="CaretBrush" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource Stroke}"/><Setter Property="Padding" Value="12,8"/><Setter Property="MinHeight" Value="44"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Margin" Value="8"/></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="RowBackground" Value="{StaticResource Surface}"/><Setter Property="AlternatingRowBackground" Value="{StaticResource Canvas}"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="54"/><Setter Property="ColumnHeaderHeight" Value="44"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="CanUserReorderColumns" Value="False"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="IsReadOnly" Value="False"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{StaticResource Stroke}"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Padding" Value="12,8"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="10,4"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource Stroke}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Trigger></Style.Triggers></Style>
  <Style TargetType="TabItem"><Setter Property="Background" Value="{StaticResource Stroke}"/><Setter Property="Foreground" Value="{StaticResource Canvas}"/><Setter Property="Padding" Value="12,7"/></Style>
 </Window.Resources>
 <Grid Margin="24">
  <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16,24"><DockPanel>
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="ClearGuard" FlowDirection="LeftToRight" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Accent}"/><TextBlock Text="فضای بیشتر. کنترل کامل." Margin="0,6,0,30" Foreground="{StaticResource Muted}"/>
    <Button x:Name="NavHome" Style="{StaticResource Nav}" Content="◈   نمای کلی"/>
    <Button x:Name="NavDashboard" Style="{StaticResource Nav}" Content="▥   داشبورد رشد فضا"/>
    <Button x:Name="NavCache" Style="{StaticResource Nav}" Content="⌁   کش‌های قابل بازسازی"/>
    <Button x:Name="NavInventory" Style="{StaticResource Nav}" Content="▤   فایل‌های حجیم"/>
    <Button x:Name="NavApps" Style="{StaticResource Nav}" Content="▣   برنامه‌های نصب‌شده"/>
    <Button x:Name="NavSources" Style="{StaticResource Nav}" Content="⧉   سورس‌ها و تکراری‌ها"/>
    <Button x:Name="NavOrganize" Style="{StaticResource Nav}" Content="▦   دسته‌بندی دسکتاپ"/>
    <Button x:Name="NavHistory" Style="{StaticResource Nav}" Content="↶   تاریخچه و بازگردانی"/>
    <Button x:Name="NavProtected" Style="{StaticResource Nav}" Content="▧   پوشه‌های محافظت‌شده"/>
    <Button x:Name="NavUpdates" Style="{StaticResource Nav}" Content="↥   بررسی آپدیت"/>
    <Button x:Name="NavSafety" Style="{StaticResource Nav}" Content="◇   قواعد محافظت"/>
    <Border BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Padding="0,18,0,0" Margin="0,24,0,0"><StackPanel><TextBlock Text="●  محلی و بدون تبلیغ" Foreground="{StaticResource Accent}"/><TextBlock Text="اینترنت فقط برای بررسی دستی آپدیت؛ حذف خودکار ندارد." FontSize="14" Margin="0,10,0,8" Foreground="{StaticResource Muted}"/><TextBlock Text="Windows 10 / 11 · v1.2.0" FlowDirection="LeftToRight" FontSize="13" Foreground="{StaticResource Muted}"/></StackPanel></Border>
   </StackPanel></ScrollViewer>
  </DockPanel></Border>
  <Grid Grid.Column="2">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageTitle" Text="پاک‌سازی، با خیال راحت" FontSize="32" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="اول ببینید چه چیزی فضا گرفته؛ بعد آگاهانه تصمیم بگیرید." Foreground="{StaticResource Muted}" Margin="0,6,0,20"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="BtnStorage" Content="تنظیمات فضای ویندوز ↗" Background="Transparent"/><Button x:Name="BtnExit" Content="خروج ✕" ToolTip="خروج از برنامه؛ عملیات فعال ابتدا با توقف امن پایان می‌یابد." AutomationProperties.Name="خروج از ClearGuard" Margin="10,0,0,0"/></StackPanel></Grid>
   <Grid Grid.Row="1" Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="فضای آزاد درایو C" Foreground="{StaticResource Muted}"/><TextBlock x:Name="FreeValue" Text="—" FlowDirection="LeftToRight" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,8"/><ProgressBar x:Name="DiskBar" Height="5" Background="{StaticResource Stroke}" Foreground="{StaticResource Accent}"/><TextBlock x:Name="DiskCaption" Text="اطلاعات زندهٔ درایو" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,10,0,0"/></StackPanel></Border>
    <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="MetricCaption" Text="قابل پاک‌سازی در اسکن" Foreground="{StaticResource Muted}"/><TextBlock x:Name="SafeValue" Text="اسکن نشده" Foreground="{StaticResource Accent}" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,8"/><TextBlock x:Name="SafeCaption" Text="بدون انتخاب و تأیید حذف نمی‌شود." Foreground="{StaticResource Muted}" FontSize="13"/></StackPanel></Border>
    <Border Grid.Column="4" Style="{StaticResource Card}"><StackPanel><TextBlock Text="محافظت همیشه فعال" Foreground="{StaticResource Muted}"/><TextBlock Text="رسانه + پروژه" FontSize="27" FontWeight="SemiBold" Margin="0,10,0,8"/><TextBlock Text="Downloads، Codex و فایل‌های سیستمی دست‌نخورده می‌مانند." Foreground="{StaticResource Muted}" FontSize="13"/></StackPanel></Border>
   </Grid>
   <Grid Grid.Row="2">
    <ScrollViewer x:Name="HomePanel" VerticalScrollBarVisibility="Auto"><StackPanel>
     <Border Style="{StaticResource Card}" Padding="28"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="هیچ چیز، بدون بررسی حذف نمی‌شود." FontSize="26" FontWeight="SemiBold"/><TextBlock Text="کش‌های شناخته‌شده، فایل‌های حجیم و نسخه‌های تکراری را پیدا کنید. هر مورد با مسیر کامل، حجم، دلیل محافظت و اثر پاک‌سازی نمایش داده می‌شود." Margin="0,14,0,20" Foreground="{StaticResource Muted}"/><WrapPanel><Button x:Name="BtnStart" Content="شروع اسکن کش‌ها ←" Style="{StaticResource Primary}" Margin="0,0,0,12"/><Button x:Name="BtnExplore" Content="بررسی فایل‌های حجیم" Margin="12,0,0,12"/></WrapPanel><TextBlock Text="برنامه‌های در حال اجرا بسته نمی‌شوند؛ موارد قفل‌شده کنار گذاشته می‌شوند." FontSize="14" Foreground="{StaticResource Muted}"/></StackPanel><Viewbox Grid.Column="1" Width="136" Height="156" Margin="18"><Canvas Width="120" Height="140"><Path Stroke="{StaticResource Accent}" StrokeThickness="3" Fill="{StaticResource Stroke}" Data="M60,5 L108,22 L108,65 Q108,107 60,132 Q12,107 12,65 L12,22 Z"/><Path Stroke="{StaticResource Accent}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M36,68 L52,85 L83,48"/></Canvas></Viewbox></Grid></Border>
     <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="پاک‌سازی توسعه‌دهنده" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Gradle، Android Studio، npm، pip، Go و کش‌های updater با کنترل برنامه‌های فعال و نگهداری LocalHistory." Margin="0,12,0,0" Foreground="{StaticResource Muted}"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="دسکتاپ، بدون از دست رفتن داده" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="اسکن سورس، تطبیق SHA-256، دسته‌بندی فایل‌های مستقل و بازگردانی عملیات بدون بازنویسی فایل‌های شما." Margin="0,12,0,0" Foreground="{StaticResource Muted}"/></StackPanel></Border></Grid>
     <Border Style="{StaticResource Card}" Margin="0,16,0,0"><TextBlock Text="نکتهٔ مهم: انتقال به Recycle Bin قابل بازیابی است، اما تا وقتی در سطل باقی بماند فضای درایو آزاد نمی‌شود. حذف دائمی فقط برای کش‌های تأییدشده و با تأیید جداگانه ارائه می‌شود." Foreground="{StaticResource Warning}"/></Border>
    </StackPanel></ScrollViewer>
    <Grid x:Name="ResultsPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" ToolTip="جست‌وجوی نام، مسیر، برنامه یا وضعیت"/><Button x:Name="BtnScan" Grid.Column="1" Content="اسکن / تازه‌سازی" Margin="12,0,0,0"/><Button x:Name="BtnExport" Grid.Column="2" Content="گزارش ↗" Margin="12,0,0,0"/></Grid><WrapPanel x:Name="InventoryOptions" Visibility="Collapsed" Margin="0,0,0,10"><TextBlock Text="محدودهٔ اسکن:" VerticalAlignment="Center" Margin="0,0,0,0"/><TextBox x:Name="RootPath" Width="320" FlowDirection="LeftToRight" Margin="12,0,0,0"/><Button x:Name="BtnWholeC" Content="کل C" Margin="12,0,0,0"/><Button x:Name="BtnDuplicates" Content="تکراری‌های قطعی (SHA)" Margin="12,0,0,0"/></WrapPanel><TextBlock x:Name="ResultHint" Text="اسکن فقط خواندنی است." Foreground="{StaticResource Muted}" FontSize="14" Margin="0,0,0,12"/></StackPanel>
     <DataGrid x:Name="ResultsGrid" Grid.Row="1"><DataGrid.Columns>
      <DataGridTemplateColumn Width="48"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Eligible}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTextColumn Header="مورد / برنامه" Binding="{Binding Name}" Width="2*" IsReadOnly="True"/>
      <DataGridTextColumn Header="حجم" Binding="{Binding Size}" SortMemberPath="Bytes" Width="108" IsReadOnly="True"/>
      <DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="170" IsReadOnly="True"/>
      <DataGridTextColumn Header="مسیر" Binding="{Binding Path}" Width="3*" IsReadOnly="True"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
     </DataGrid.Columns></DataGrid>
     <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="DetailTitle" Text="یک ردیف را برای دیدن جزئیات انتخاب کنید." FontWeight="SemiBold"/><TextBox x:Name="DetailPath" Grid.Row="1" IsReadOnly="True" FlowDirection="LeftToRight" MinHeight="0" BorderThickness="0" Background="Transparent" Padding="0,6"/><TextBlock x:Name="DetailEffect" Grid.Row="2" Foreground="{StaticResource Muted}" FontSize="14" MaxHeight="90"/></Grid></Border>
    </Grid>
    <Grid x:Name="AppsPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="AppsSearch" ToolTip="جست‌وجوی نام، نسخه، ناشر یا مسیر نصب" AutomationProperties.Name="جست‌وجوی برنامه‌های نصب‌شده"/><ComboBox x:Name="AppsTypeFilter" Grid.Column="1" Margin="10,0,0,0" Height="44" VerticalContentAlignment="Center" Foreground="Black" SelectedIndex="0" AutomationProperties.Name="نوع برنامه"><ComboBoxItem Tag="all" Content="همهٔ برنامه‌ها"/><ComboBoxItem Tag="registry" Content="برنامه‌های دسکتاپ"/><ComboBoxItem Tag="store" Content="Microsoft Store"/></ComboBox><Button x:Name="BtnAppsScan" Grid.Column="2" Content="اسکن برنامه‌ها" Margin="10,0,0,0"/><Button x:Name="BtnAppsExport" Grid.Column="3" Content="گزارش ↗" IsEnabled="False" Margin="10,0,0,0"/></Grid><TextBlock x:Name="AppsHint" Text="فهرست فقط خواندنی است؛ هیچ برنامه‌ای حذف یا تعمیر نمی‌شود. حجم ثبت‌شده ممکن است تخمینی باشد." Foreground="{StaticResource Muted}" FontSize="14" Margin="0,0,0,12"/></StackPanel>
     <DataGrid x:Name="AppsGrid" Grid.Row="1" IsReadOnly="True" AutomationProperties.Name="فهرست برنامه‌های نصب‌شده"><DataGrid.Columns><DataGridTextColumn Header="برنامه" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="نسخه" Binding="{Binding Version}" Width="110"/><DataGridTextColumn Header="حجم" Binding="{Binding SizeDisplay}" SortMemberPath="SizeBytes" Width="128"/><DataGridTextColumn Header="ناشر" Binding="{Binding Publisher}" Width="*"/><DataGridTextColumn Header="نوع حجم" Binding="{Binding SizeKindDisplay}" Width="150"/></DataGrid.Columns></DataGrid>
     <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16"><StackPanel><Button x:Name="BtnAppsMeasure" Content="اندازه‌گیری پوشهٔ نصب" IsEnabled="False" HorizontalAlignment="Right" ToolTip="فقط خواندن طول فایل‌ها در پوشهٔ نصب انتخاب‌شده؛ ریشهٔ پوشه‌های مشترک و شخصی، Windows و مسیرهای لینک‌شده اندازه‌گیری نمی‌شوند."/><TextBox x:Name="AppsDetail" Text="یک برنامه را برای دیدن مسیر نصب و منشأ حجم انتخاب کنید." IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="68" MaxHeight="108" Background="Transparent" BorderThickness="0" Margin="0,8,0,0" AutomationProperties.Name="جزئیات برنامه و منشأ حجم"/></StackPanel></Border>
    </Grid>
    <Grid x:Name="DashboardPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="محدودهٔ اسکن (پوشهٔ محلی)" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="DashboardRoot" FlowDirection="LeftToRight" AutomationProperties.Name="مسیر پوشه برای داشبورد"/><Button x:Name="BtnDashboardScan" Grid.Column="1" Content="اسکن و ثبت وضعیت" Style="{StaticResource Primary}" Margin="12,0,0,0"/></Grid><TextBlock x:Name="DashboardHint" Text="با درخواست شما اسکن می‌شود. رشد فقط بین دو اسکن کاملِ یک محدوده و با شرایط یکسان محاسبه می‌شود." Foreground="{StaticResource Muted}" FontSize="14" Margin="0,10,0,12"/></StackPanel>
     <DataGrid x:Name="DashboardGrid" Grid.Row="1" IsReadOnly="True" RowHeight="66" AutomationProperties.Name="نمودار و رشد حجم پوشه‌ها"><DataGrid.Columns>
      <DataGridTextColumn Header="پوشه / دسته" Binding="{Binding Name}" Width="2*"/>
      <DataGridTextColumn Header="حجم مشاهده‌شده" Binding="{Binding SizeDisplay}" SortMemberPath="ObservedBytes" Width="150"/>
      <DataGridTextColumn Header="تغییر" Binding="{Binding DeltaDisplay}" SortMemberPath="DeltaBytes" Width="130"/>
      <DataGridTemplateColumn Header="نسبت به بزرگ‌ترین دسته" Width="180"><DataGridTemplateColumn.CellTemplate><DataTemplate><ProgressBar Value="{Binding Ratio}" Maximum="100" Height="12" Foreground="{StaticResource Accent}" Background="{StaticResource Stroke}" Margin="6" AutomationProperties.Name="نسبت حجم دسته به بزرگ‌ترین دسته"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     </DataGrid.Columns></DataGrid>
     <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0"><TextBox x:Name="DashboardDetail" Text="اسکن اولیه خط مبنای مقایسه می‌شود؛ چیزی برای حذف انتخاب نمی‌شود." IsReadOnly="True" TextWrapping="Wrap" MaxHeight="100" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" AutomationProperties.Name="جزئیات و محدودیت‌های داشبورد"/></Border>
    </Grid>
    <Grid x:Name="ProtectedPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="این فهرست فقط محافظت اضافه می‌کند؛ قواعد ثابت رسانه، سورس، SDK، Codex و سیستم قابل خاموش‌کردن نیستند." Foreground="{StaticResource Muted}" Margin="0,0,0,14"/><TextBlock Text="مسیر کامل یک پوشهٔ موجود" Margin="0,0,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ProtectedPathInput" FlowDirection="LeftToRight" AutomationProperties.Name="مسیر پوشه‌ای که همیشه محافظت شود"/><Button x:Name="BtnProtectedAdd" Grid.Column="1" Content="افزودن محافظت" Margin="12,0,0,0"/></Grid><TextBlock x:Name="ProtectedHint" Text="ثبت فقط در تنظیمات محلی ClearGuard انجام می‌شود؛ محتوای پوشه تغییر نمی‌کند." Foreground="{StaticResource Muted}" Margin="0,10,0,14" FontSize="14"/></StackPanel>
     <ListBox x:Name="ProtectedList" Grid.Row="1" FlowDirection="LeftToRight" Background="{StaticResource Surface}" Foreground="{StaticResource Ink}" BorderThickness="0" Padding="12" FontSize="16" AutomationProperties.Name="پوشه‌های محافظت‌شدهٔ شخصی"/>
     <StackPanel Grid.Row="2" Margin="0,14,0,0"><Button x:Name="BtnProtectedRemove" Content="برداشتن محافظتِ شخصیِ انتخاب‌شده" IsEnabled="False" HorizontalAlignment="Right"/><TextBlock x:Name="ProtectedStorePath" Foreground="{StaticResource Muted}" FlowDirection="LeftToRight" FontSize="12" Margin="0,10,0,0"/></StackPanel>
    </Grid>
    <ScrollViewer x:Name="UpdatesPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="آپدیت با کنترل شما" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="UpdateCurrentVersion" FlowDirection="LeftToRight" Foreground="{StaticResource Accent}" Margin="0,10,0,0"/><TextBlock Text="بررسی فقط پس از زدن دکمه انجام می‌شود و یک درخواست HTTPS به GitHub می‌فرستد. هیچ مسیر فایل، اسکن یا اطلاعات شخصی ارسال نمی‌شود. دانلود، نصب و اجرا خودکار نیست." Foreground="{StaticResource Muted}" Margin="0,12,0,16"/><WrapPanel><Button x:Name="BtnUpdateCheck" Content="بررسی نسخهٔ جدید" Style="{StaticResource Primary}"/><Button x:Name="BtnUpdateOpen" Content="صفحهٔ رسمی نسخه ↗" IsEnabled="False" Margin="12,0,0,0"/></WrapPanel><TextBlock x:Name="UpdateStatus" Text="هنوز بررسی نشده؛ در شروع برنامه ارتباط اینترنتی برقرار نمی‌شود." Foreground="{StaticResource Warning}" Margin="0,16,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="تغییرات نسخه (متن دریافتی از GitHub)" FontSize="20"/><TextBox x:Name="UpdateNotes" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="120" MaxHeight="230" Background="Transparent" BorderThickness="0" Margin="0,12,0,0" AutomationProperties.Name="توضیحات خواندنی نسخهٔ منتشرشده"/><TextBlock Text="هنگام ارتقا، برنامه را ببندید و رسیدها و تنظیمات را نگه دارید. نسخهٔ قبلی برای بازگشت حفظ شود؛ checksum به‌تنهایی تأیید هویت ناشر نیست." Foreground="{StaticResource Muted}" FontSize="14" Margin="0,14,0,0"/></StackPanel></Border></StackPanel></ScrollViewer>
    <Grid x:Name="HistoryPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="رسیدها شامل مقدار دقیق فایل‌ها، فضای آزاد قبل و بعد و دلیل رد شدن هر مورد هستند. بازیابی فایل موجود را بازنویسی نمی‌کند." Foreground="{StaticResource Muted}" Margin="0,0,0,16"/><ListBox x:Name="HistoryList" Grid.Row="1" Background="{StaticResource Surface}" Foreground="{StaticResource Ink}" BorderThickness="0" Padding="12" FontSize="17"/><StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0"><Button x:Name="BtnRestore" Content="بازگردانی عملیات انتخاب‌شده"/><Button x:Name="BtnReportFolder" Content="باز کردن پوشهٔ گزارش‌ها ↗" Margin="12,0,0,0"/><Button x:Name="BtnRecycleBin" Content="باز کردن Recycle Bin ↗" Margin="12,0,0,0"/></StackPanel></Grid>
    <ScrollViewer x:Name="SafetyPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="خط قرمزهایی که قابل خاموش کردن نیستند" FontSize="24" FontWeight="SemiBold"/><TextBlock Margin="0,18,0,0" Text="• عکس، ویدیو و فایل دارای امضای رسانه، حتی با پسوند تغییرکرده&#10;• Documents، Desktop، Downloads و سورس‌کد در پاک‌سازی کش&#10;• APK / AAB، کلیدهای امضا، داده‌های شخصی و فایل ناشناخته&#10;• SYMEXVPN و ProxyX؛ نسخهٔ اصلی و شاخه‌های مستقل&#10;• Android SDK، NDK، AVD و Snapshot شبیه‌ساز&#10;• LocalHistory اندروید استودیو و داده‌های Codex/runtime&#10;• Windows Installer، WinSxS، Package Cache، Event Logs&#10;• پوشهٔ برنامه‌های نصب‌شده و IDM incomplete downloads&#10;• junction / symlink: بدون دنبال کردن یا حذف" Foreground="{StaticResource Muted}" LineHeight="32"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="بررسی دوباره، درست پیش از حذف" FontSize="22"/><TextBlock Text="هش، مسیر مجاز، وجود رسانه، وضعیت برنامهٔ مرتبط و تغییرات فایل دوباره بررسی می‌شوند. در صورت قفل، دسترسی ناموفق یا تردید، فایل باقی می‌ماند. هیچ برنامه‌ای به‌اجبار بسته نمی‌شود." Margin="0,12,0,0" Foreground="{StaticResource Muted}"/><TextBlock Text="Maven: صرفاً گزارش؛ dependencyهای محلی و ناشناخته حذف نمی‌شوند. پاک‌سازی Windows Update فقط از ابزار رسمی ویندوز انجام می‌شود." Margin="0,14,0,0" Foreground="{StaticResource Warning}"/></StackPanel></Border></StackPanel></ScrollViewer>
   </Grid>
   <Grid Grid.Row="3" Margin="0,18,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ProgressBar x:Name="WorkBar" Height="3" Visibility="Collapsed" Background="{StaticResource Stroke}" Foreground="{StaticResource Accent}"/><Grid Grid.Row="1" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="آماده · هیچ عملیات حذف خودکار انجام نمی‌شود." Foreground="{StaticResource Muted}" VerticalAlignment="Center" MaxHeight="60"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="BtnCancel" Content="توقف" Visibility="Collapsed" Margin="12,0,0,0"/><Button x:Name="BtnSelectSafe" Content="انتخاب موارد مجاز" Visibility="Collapsed" Margin="12,0,0,0"/><ComboBox x:Name="CleanupMode" Visibility="Collapsed" Width="172" Height="44" VerticalContentAlignment="Center" Margin="12,0,0,0" Foreground="Black" SelectedIndex="0"><ComboBoxItem Content="Recycle Bin"/><ComboBoxItem Content="حذف دائمیِ کش"/></ComboBox><Button x:Name="BtnApply" Content="بررسی انتخاب‌ها ←" Style="{StaticResource Primary}" Visibility="Collapsed" Margin="12,0,0,0"/></StackPanel></Grid></Grid>
  </Grid>
